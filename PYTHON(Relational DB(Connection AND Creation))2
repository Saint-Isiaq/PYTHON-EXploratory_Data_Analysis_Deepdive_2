"""
======================================================
##DB Query: Querying Relational DB Directly With Pandas
#Exercise 7.1
====================================================== """

# Importing packages
from sqlalchemy import create_engine
import pandas as pd

# Creating engine: engine
engine = create_engine('sqlite:///Chinook.sqlite')

""" 
              Querying DB Engine Directly
 In One Line CODE With Pandas
"""
# Executing query and store records in DataFrame: df
df = pd.read_sql_query('SELECT * FROM Album', engine)

# Printing head of DataFrame
print(df.head())


"""
              A Logical Operation To Determine,
If CONTEXT Manager Yields Same Results as Method Above
"""

# Opening engine in context manager and store query result in df1
with engine.connect() as con:
    rs = con.execute("SELECT * FROM Album")
    df1 = pd.DataFrame(rs.fetchall())
    df1.columns = rs.keys()

# Confirming that both methods yield the same result
print(df.equals(df1))



