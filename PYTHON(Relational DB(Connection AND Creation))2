"""
--ADVANCED RELATIONAL DB QUERYING
======================================================
##DB Query: Querying Relational DB Directly With Pandas: Ordering AND Filtering
#Exercise 9.1
====================================================== """

# Importing packages
from sqlalchemy import create_engine
import pandas as pd

# Creating engine: engine
engine = create_engine('sqlite:///Chinook.sqlite')

# Opening engine in context manager
# Perform query and save results to DataFrame: df
with engine.connect() as con:
    rs = con.execute('SELECT Title, Name FROM Album INNER JOIN Artist On Album.ArtistID = Artist.ArtistID') """ JOINS """
    df = pd.DataFrame(rs.fetchall())
    df.columns = rs.keys()

# Print head of DataFrame df
print(df.head())


