##DB Creation AND Connection: Querying Data Tables From The Engine
#Exercise 3.1
======================================================   """

# Import packages
from sqlalchemy import create_engine
import pandas as pd

# Creating engine: engine
engine = create_engine('sqlite:///Chinook.sqlite')
"""NOTE📒:
        engine = create_engine('db_engine:///schemaname.db_engine')"""

# Opening engine connection: con
con = engine.connect()

# Performing query: rs
rs = con.execute("SELECT * FROM Album")

# Saving results of the query to DataFrame: df
df = pd.DataFrame(rs.fetchall())

# Closing connection
con.close()

# Print head of DataFrame df
print(df.head())

"""
======================================================
##DB Query: Querying Data Tables Using a Context Manger 
#Exercise 4.1
======================================================   """

# Import packages
from sqlalchemy import create_engine
import pandas as pd

# Creating engine: engine
engine = create_engine('sqlite:///Chinook.sqlite')
"""NOTE📒:
        engine = create_engine('db_engine:///schemaname.db_engine')"""
"""
The Context Manager Format : with 
"""
# Perform query and save results to DataFrame: df
with engine.connect() as con:
    rs = con.execute("SELECT LastName,Title FROM Employee")
    df = pd.DataFrame(rs.fetchmany(size=3))
    df.columns = rs.keys()

# Print the length of the DataFrame df
print(len(df))

# Print the head of the DataFrame df
print(df.head())

