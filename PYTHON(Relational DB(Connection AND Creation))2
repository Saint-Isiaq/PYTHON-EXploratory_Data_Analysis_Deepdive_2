======================================================  """
##PACKAGE IMPORTS
from sqlalchemy import create_engine
import pandas as pd

# Creating engine: engine
engine = create_engine('sqlite:///Chinook.sqlite')
"""NOTE📒:
        engine = create_engine('db_engine:///schemaname.db_engine')"""

# Opening engine in context manager
# Performing query and save results to DataFrame: df
with engine.connect() as con:
    rs = con.execute('SELECT * FROM Employee WHERE "EmployeeId" >= 6')
    df = pd.DataFrame(rs.fetchall())
    df.columns = rs.keys()

# Printing the head of the DataFrame df
print(df.head())

