# Import packages
import requests
from bs4 import BeautifulSoup

# Specifying url
url = 'https://www.python.org/~guido/'

# Packaging the request, sending the request and catch the response: r
r = requests.get(url)

# Extracting the response as html: html_doc
html_doc = r.text

# creating a BeautifulSoup object from the HTML: soup
soup = BeautifulSoup(html_doc)

# Printing the title of Guido's webpage
print(soup.title)

# Finding all 'a' tags (which define hyperlinks): a_tags
a_tags = soup.find_all('a')

# Printing the URLs to the shell
for link in a_tags:
    print(link.get('href'))

