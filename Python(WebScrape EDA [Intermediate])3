""" Needed Packages """
# Import package
from urllib.request import urlretrieve

# Importing pandas
import pandas as pd

# Assigning url of file: url
url = 'https://assets.datacamp.com/production/course_1606/datasets/winequality-red.csv'
    """WebSite's URL Link Goes Here"""

# Saving file locally
urlretrieve(url,'winequality-red.csv')

# Reading file into a DataFrame and printing its head
df = pd.read_csv('winequality-red.csv', sep=';')
print(df.head())


