# Importing packages
from urllib.request import urlopen, Request

# Specifying the url
url = "https://campus.datacamp.com/courses/1606/4135?ex=2"

# This packages the request
request = Request(url)

# Sending the request and catching the response: response
response = urlopen(request)

# Extracting the response: html
html = response.read()

# Printing the html
print(html)

# close the response!
response.close()

