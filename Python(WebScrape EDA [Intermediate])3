# Import packages
import matplotlib.pyplot as plt
import pandas as pd

# Assigning url of file: url
url = 'https://assets.datacamp.com/course/importing_data_into_r/latitude.xls'

# Reading in all sheets of Excel file: xls
xls = pd.read_excel(url, sheet_name = None)

# Printing the sheetnames to the shell
print(xls.keys())

# Printing the head of the first sheet (using its name, NOT its index)
print(xls['1700'].head())

